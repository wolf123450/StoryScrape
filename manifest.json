{
  "manifest_version": 2,
  "name": "StoryScrape",
  "version": "1.0",
  "description": "Scrape stories and save them as EPUB.",
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icons/book-solid.svg"
  },
  "icons": {
    "16": "icons/book-solid.svg",
    "48": "icons/book-solid.svg",
    "128": "icons/book-solid.svg"
  },
  "applications": {
    "gecko": {
      "id": "storyscrape@apollo.com"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["libs/jszip.min.js", "libs/FileSaver.min.js", "content.js"]
    }
  ]
}
